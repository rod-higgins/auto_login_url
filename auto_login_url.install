<?php

/**
 * @file
 * Install, update and uninstall functions for Auto Login URL module.
 */

declare(strict_types=1);

/**
 *
 */
function auto_login_url_schema(): array {
  $schema['auto_login_url'] = [
    'description' => 'Stores auto login URL tokens and associated data.',
    'fields' => [
      'id' => [
        'description' => 'Primary key: unique ID for the auto login record.',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid for the user.',
      ],
      'hash' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Cryptographic hash for the auto login token.',
      ],
      'destination' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'The destination URL after successful login.',
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the token was created.',
      ],
      'ip_address' => [
        'type' => 'varchar',
      // Support IPv6.
        'length' => 45,
        'not null' => FALSE,
        'description' => 'IP address where token was created.',
      ],
      'user_agent' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'User agent when token was created.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'hash_lookup' => ['hash'],
      'uid_lookup' => ['uid'],
      'timestamp_cleanup' => ['timestamp'],
      'uid_timestamp' => ['uid', 'timestamp'],
      'ip_timestamp' => ['ip_address', 'timestamp'],
    // Enhanced composite index.
      'uid_hash_lookup' => ['uid', 'hash'],
    ],
    'foreign keys' => [
      'auto_login_user' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];

  $schema['auto_login_url_usage'] = [
    'description' => 'Tracks auto login URL usage for analytics.',
    'fields' => [
      'id' => [
        'description' => 'Primary key: unique ID for the usage record.',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'original_id' => [
        'description' => 'Reference to original auto_login_url record.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The user ID who used the URL.',
      ],
      'used_timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix timestamp when URL was used.',
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
        'description' => 'IP address where URL was used.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_timestamp' => ['uid', 'used_timestamp'],
      'original_id' => ['original_id'],
      'usage_cleanup' => ['used_timestamp'],
    ],
    'foreign keys' => [
      'usage_user' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function auto_login_url_install(): void {
  \Drupal::logger('auto_login_url')->info('Auto Login URL module installed successfully.');
}

/**
 * Implements hook_uninstall().
 */
function auto_login_url_uninstall(): void {
  // Clean up any remaining configuration.
  \Drupal::configFactory()->getEditable('auto_login_url.settings')->delete();

  // Clean up state variables used by rate limiting.
  $state = \Drupal::state();
  $keys = $state->getMultiple([]);
  foreach ($keys as $key => $value) {
    if (str_starts_with($key, 'auto_login_url.create_rate.')) {
      $state->delete($key);
    }
  }

  \Drupal::logger('auto_login_url')->info('Auto Login URL module uninstalled and configuration cleaned up.');
}

/**
 * Update 8001: Add token length configuration.
 */
function auto_login_url_update_8001(): void {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('auto_login_url.settings');

  if (!$config->get('token_length')) {
    $config->set('token_length', 64);
    $config->save(TRUE);
  }
}

/**
 * Update 8002: Reset secret for security.
 */
function auto_login_url_update_8002(): void {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('auto_login_url.settings');
  $config->set('secret', '');
  $config->save(TRUE);
}

/**
 * Update 10001: Improve database schema for Drupal 10+.
 */
function auto_login_url_update_10001(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Add new indexes for better performance.
  if (!$schema->indexExists('auto_login_url', 'uid_timestamp')) {
    $schema->addIndex('auto_login_url', 'uid_timestamp', ['uid', 'timestamp'], [
      'indexes' => [
        'uid_timestamp' => ['uid', 'timestamp'],
      ],
    ]);
  }

  // Extend hash field length for future compatibility.
  $schema->changeField('auto_login_url', 'hash', 'hash', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => TRUE,
    'default' => '',
    'description' => 'Cryptographic hash for the auto login token.',
  ]);

  \Drupal::logger('auto_login_url')->info('Database schema updated for Drupal 10+ compatibility.');
}

/**
 * Update 11001: Add IP tracking and enhanced indexes.
 */
function auto_login_url_update_11001(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Add IP address field.
  if (!$schema->fieldExists('auto_login_url', 'ip_address')) {
    $schema->addField('auto_login_url', 'ip_address', [
      'type' => 'varchar',
      'length' => 45,
      'not null' => FALSE,
      'description' => 'IP address where token was created.',
    ]);
  }

  // Add user agent field.
  if (!$schema->fieldExists('auto_login_url', 'user_agent')) {
    $schema->addField('auto_login_url', 'user_agent', [
      'type' => 'text',
      'not null' => FALSE,
      'description' => 'User agent when token was created.',
    ]);
  }

  // Add IP+timestamp index.
  if (!$schema->indexExists('auto_login_url', 'ip_timestamp')) {
    $schema->addIndex('auto_login_url', 'ip_timestamp', ['ip_address', 'timestamp']);
  }

  \Drupal::logger('auto_login_url')->info('Enhanced tracking fields and indexes added.');
}

/**
 * Update 11002: Add usage analytics table and enhanced configuration.
 */
function auto_login_url_update_11002(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Create usage analytics table.
  if (!$schema->tableExists('auto_login_url_usage')) {
    $table_schema = [
      'description' => 'Tracks auto login URL usage for analytics.',
      'fields' => [
        'id' => [
          'description' => 'Primary key: unique ID for the usage record.',
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'original_id' => [
          'description' => 'Reference to original auto_login_url record.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'The user ID who used the URL.',
        ],
        'used_timestamp' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'Unix timestamp when URL was used.',
        ],
        'ip_address' => [
          'type' => 'varchar',
          'length' => 45,
          'not null' => FALSE,
          'description' => 'IP address where URL was used.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'uid_timestamp' => ['uid', 'used_timestamp'],
        'original_id' => ['original_id'],
        'usage_cleanup' => ['used_timestamp'],
      ],
      'foreign keys' => [
        'usage_user' => [
          'table' => 'users',
          'columns' => ['uid' => 'uid'],
        ],
      ],
    ];

    $schema->createTable('auto_login_url_usage', $table_schema);
  }

  // Add enhanced composite index for better performance.
  if (!$schema->indexExists('auto_login_url', 'uid_hash_lookup')) {
    $schema->addIndex('auto_login_url', 'uid_hash_lookup', ['uid', 'hash']);
  }

  // Add new configuration options with defaults.
  $config = \Drupal::configFactory()->getEditable('auto_login_url.settings');

  if ($config->get('validate_ip_address') === NULL) {
    $config->set('validate_ip_address', FALSE);
  }

  if ($config->get('enable_usage_analytics') === NULL) {
    $config->set('enable_usage_analytics', TRUE);
  }

  if ($config->get('max_urls_per_user_per_hour') === NULL) {
    $config->set('max_urls_per_user_per_hour', 10);
  }

  $config->save(TRUE);

  \Drupal::logger('auto_login_url')->info('Enhanced analytics and security features added.');
}

/**
 * Update 11003: Clean up old analytics data to prevent unlimited growth.
 */
function auto_login_url_update_11003(): void {
  $database = \Drupal::database();

  // Only keep analytics data for the last 6 months to prevent table growth.
  if ($database->schema()->tableExists('auto_login_url_usage')) {
    // 6 months ago
    $cutoff_time = time() - (6 * 30 * 24 * 60 * 60);

    $deleted = $database->delete('auto_login_url_usage')
      ->condition('used_timestamp', $cutoff_time, '<=')
      ->execute();

    if ($deleted > 0) {
      \Drupal::logger('auto_login_url')->info('Cleaned up @count old analytics records during update', [
        '@count' => $deleted,
      ]);
    }
  }
}
