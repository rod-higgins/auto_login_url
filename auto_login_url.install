<?php

/**
 * @file
 * Install, update and uninstall functions for Auto Login URL module.
 */

declare(strict_types=1);

function auto_login_url_schema(): array {
  $schema['auto_login_url'] = [
    'description' => 'Stores auto login URL tokens and associated data.',
    'fields' => [
      'id' => [
        'description' => 'Primary key: unique ID for the auto login record.',
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The {users}.uid for the user.',
      ],
      'hash' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Cryptographic hash for the auto login token.',
      ],
      'destination' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'The destination URL after successful login.',
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the token was created.',
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45, // Support IPv6
        'not null' => FALSE,
        'description' => 'IP address where token was created.',
      ],
      'user_agent' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'User agent when token was created.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'hash_lookup' => ['hash'],
      'uid_lookup' => ['uid'],
      'timestamp_cleanup' => ['timestamp'],
      'uid_timestamp' => ['uid', 'timestamp'],
      'ip_timestamp' => ['ip_address', 'timestamp'],
    ],
    'foreign keys' => [
      'auto_login_user' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function auto_login_url_install(): void {
  \Drupal::logger('auto_login_url')->info('Auto Login URL module installed successfully.');
}

/**
 * Implements hook_uninstall().
 */
function auto_login_url_uninstall(): void {
  // Clean up any remaining configuration.
  \Drupal::configFactory()->getEditable('auto_login_url.settings')->delete();
  \Drupal::logger('auto_login_url')->info('Auto Login URL module uninstalled and configuration cleaned up.');
}

/**
 * Update 8001: Add token length configuration.
 */
function auto_login_url_update_8001(): void {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('auto_login_url.settings');
  
  if (!$config->get('token_length')) {
    $config->set('token_length', 64);
    $config->save(TRUE);
  }
}

/**
 * Update 8002: Reset secret for security.
 */
function auto_login_url_update_8002(): void {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('auto_login_url.settings');
  $config->set('secret', '');
  $config->save(TRUE);
}

/**
 * Update 10001: Improve database schema for Drupal 10+.
 */
function auto_login_url_update_10001(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Add new indexes for better performance.
  if (!$schema->indexExists('auto_login_url', 'uid_timestamp')) {
    $schema->addIndex('auto_login_url', 'uid_timestamp', ['uid', 'timestamp'], [
      'indexes' => [
        'uid_timestamp' => ['uid', 'timestamp'],
      ],
    ]);
  }

  // Extend hash field length for future compatibility.
  $schema->changeField('auto_login_url', 'hash', 'hash', [
    'type' => 'varchar',
    'length' => 255,
    'not null' => TRUE,
    'default' => '',
    'description' => 'Cryptographic hash for the auto login token.',
  ]);

  \Drupal::logger('auto_login_url')->info('Database schema updated for Drupal 10+ compatibility.');
}

/**
 * Update 11001: Add IP tracking and enhanced indexes.
 */
function auto_login_url_update_11001(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Add IP address field
  if (!$schema->fieldExists('auto_login_url', 'ip_address')) {
    $schema->addField('auto_login_url', 'ip_address', [
      'type' => 'varchar',
      'length' => 45,
      'not null' => FALSE,
      'description' => 'IP address where token was created.',
    ]);
  }

  // Add user agent field
  if (!$schema->fieldExists('auto_login_url', 'user_agent')) {
    $schema->addField('auto_login_url', 'user_agent', [
      'type' => 'text',
      'not null' => FALSE,
      'description' => 'User agent when token was created.',
    ]);
  }

  // Add IP+timestamp index
  if (!$schema->indexExists('auto_login_url', 'ip_timestamp')) {
    $schema->addIndex('auto_login_url', 'ip_timestamp', ['ip_address', 'timestamp']);
  }

  \Drupal::logger('auto_login_url')->info('Enhanced tracking fields and indexes added.');
}